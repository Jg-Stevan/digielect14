{
  "name": "digitalizador-e14",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "prebuild": "bun scripts/aviso-basepath.mjs && bun packages/scanner-core/scripts/build-capa0-worker.mjs && bun packages/scanner-core/scripts/build-fallback-canvas-worker.mjs && bun run preparar",
    "predev": "bun run preparar",
    "preparar": "bun scripts/sincronizar-vendor.mjs && bun scripts/preparar-assets.mjs",
    "assets": "bun scripts/preparar-assets.mjs",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verificar": "bun run preparar && bun run typecheck && bun run lint && bun run test && bun run test:paquete",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:paquete": "bun test packages/scanner-core"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "fflate": "^0.8.3",
    "framer-motion": "^12.23.2",
    "heic2any": "^0.0.4",
    "jspdf": "^4.2.1",
    "next": "^16.1.1",
    "onnxruntime-web": "1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "5.1.1",
    "zustand": "^5.0.6",
    "zxing-wasm": "3.1.6",
    "@jg-stevan/scanner-core": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "bun-types": "^1.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "knip": "5.44.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT"
}
