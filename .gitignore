/tmp-audit/
/download/

# ─── PRIVACIDAD Y ARTEFACTOS LOCALES ───────────────────────────────────────
# Datos electorales reales: fotos de actas, capturas y volcados de corrida NO
# se commitean. Los modelos se materializan en build: ver el bloque de abajo.
/capturas/
/assets-locales/
/scratch/
# SEC-10/D86 — jamás versionar actas reales ni capturas con datos de jurados
actas-reales*/
docs/capturas-*/
*.onnx

# ─── BINARIOS MATERIALIZADOS (bun run preparar) ────────────────────────────
# scripts/sincronizar-vendor.mjs copia el vendor de node_modules y
# scripts/preparar-assets.mjs baja OpenCV/modelos con URL y SHA-256 fijados en
# scripts/assets.lock.json. Nada de esto se versiona.
public/vendor/onnxruntime/
public/vendor/tesseract/
public/vendor/opencv-4.5.5-core.js
public/wasm/zxing_reader.wasm
public/models/tess/*.traineddata.gz
public/models/tess/*.traineddata
# D88: la RUTA del modelo lleva versión (/models/tess/4.0.0_fast/) — los
# patrones planos de arriba no cubren la subcarpeta; el artefacto se baja en
# `bun run preparar` y jamás se versiona.
public/models/tess/**/*.traineddata.gz
public/models/tess/**/*.traineddata
public/models/rapidocr/*.onnx

# Evidencia forense conservada a propósito en el repo (regresión D65 / zip 4f9c871):
# los .log bajo docs/evidence/ son registro de verificación, no basura de dev.
!docs/evidence/**/*.log

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# Infraestructura del sandbox de desarrollo (NO es parte del producto)
/.zscripts/
/Caddyfile
