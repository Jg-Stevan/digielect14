/tmp-audit/
/download/

# ─── PRIVACIDAD Y ARTEFACTOS LOCALES ───────────────────────────────────────
# Datos electorales reales: fotos de actas, capturas y volcados de corrida NO
# se commitean. Los modelos que se sirven en producción viven SOLO en
# public/models/; cualquier .onnx descargado localmente queda fuera.
/capturas/
/assets-locales/
/scratch/
*.onnx
!public/models/**/*.onnx

# Evidencia forense conservada a propósito en el repo (regresión D65 / zip 4f9c871):
# los .log bajo docs/evidence/ son registro de verificación, no basura de dev.
!docs/evidence/**/*.log

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# Infraestructura del sandbox de desarrollo (NO es parte del producto)
/.zscripts/
/Caddyfile
