{
  "$schema": "https://unpkg.com/knip@5.44.1/schema.json",
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/app/**/*.{ts,tsx}",
        "src/**/*.test.{ts,tsx}",
        "e2e/**/*.spec.ts",
        "scripts/qa-*.ts",
        "scripts/gen-contrato-motor.ts",
        "scripts/gen-divipol.mjs",
        "scripts/build-*.mjs",
        "scripts/smoke-*.mjs",
        "scripts/aviso-basepath.mjs",
        "scripts/serve-coop-coep.mjs",
        "src/lib/e14/obs/heartbeat.worker.ts",
        "open-next.config.ts"
      ],
      "ignore": [
        "public/sw.js",
        "public/vendor/**",
        "public/scanner/**",
        "docs/archivo/**"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "@testing-library/react",
        "@testing-library/jest-dom",
        "heic2any",
        "onnxruntime-web",
        "tesseract.js",
        "zxing-wasm"
      ],
      "ignoreBinaries": ["audit"]
    },
    "packages/scanner-core": {
      "entry": ["src/**/*.ts", "workers/**/*.ts", "scripts/**/*.mjs"],
      "ignore": ["assets/**"]
    }
  }
}
