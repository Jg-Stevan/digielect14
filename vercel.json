{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "installCommand": "bun install",
  "buildCommand": "BUILD_STATIC=1 NEXT_PUBLIC_BASE_PATH=/digielect14 bun run build",
  "outputDirectory": "out",
  "rewrites": [
    { "source": "/digielect14", "destination": "/" },
    { "source": "/digielect14/", "destination": "/" },
    { "source": "/digielect14/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
