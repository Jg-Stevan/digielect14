{
        "$schema": "node_modules/wrangler/config-schema.json",
        "main": ".open-next/worker.js",
        // name = Worker existente (proyecto CF conectado a este repo). Debe coincidir
        // con el service binding self-reference de abajo.
        "name": "digielect14e",
        "compatibility_date": "2026-10-24",
        "compatibility_flags": [
                "nodejs_compat",
                "global_fetch_strictly_public"
        ],
        "assets": {
                "directory": ".open-next/assets",
                "binding": "ASSETS"
        },
        "services": [
                {
                        // Self-reference service binding, the service name must match the worker name
                        // see https://opennext.js.org/cloudflare/caching
                        "binding": "WORKER_SELF_REFERENCE",
                        "service": "digielect14e"
                }
        ],
        "images": {
                // Enable image optimization
                // see https://opennext.js.org/cloudflare/howtos/image
                "binding": "IMAGES"
        },
        // WAVE3 §A.1 — ORDEN-WAVE3-remoto-rescate-obs-v1 (ledger-remoto-envios-v1):
        // ledger REMOTO de envíos (idempotencia REAL cross-origen) — SOLO
        // SHA-256 del payload QR (jamás el payload — privacidad dura), serie
        // y metadatos mínimos. Formato 2 espacios (kit §A.1 literal).
        "d1_databases": [
          {
            "binding": "DB_ENVIOS_E14",
            "database_name": "e14-envios-remoto",
            "database_id": "c5a7be23-bdd3-403b-a550-bcc0316d4a77"
          }
        ]
}
